<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>

		<PlatformTarget>x64</PlatformTarget>
		<OutputType>Library</OutputType>
		<LangVersion>latest</LangVersion>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>

		<AssemblyName>LongTool</AssemblyName>
		<RootNamespace>LongTool</RootNamespace>
		<Version>1.0.0</Version>

		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<AppDesignerFolder>Properties-new</AppDesignerFolder>
	</PropertyGroup>


	<!-- ========================================================= -->
	<!-- Revit 2025 -->
	<!-- ========================================================= -->

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">

		<Reference Include="RevitAPI">
			<HintPath>..\..\..\..\Program Files\Autodesk\Revit 2025\RevitAPI.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="RevitAPIUI">
			<HintPath>..\..\..\..\Program Files\Autodesk\Revit 2025\RevitAPIUI.dll</HintPath>
			<Private>false</Private>
		</Reference>

	</ItemGroup>


	<!-- ========================================================= -->
	<!-- Revit 2026 -->
	<!-- ========================================================= -->

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">

		<Reference Include="RevitAPI">
			<HintPath>..\..\..\..\Program Files\Autodesk\Revit 2026\RevitAPI.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="RevitAPIUI">
			<HintPath>..\..\..\..\Program Files\Autodesk\Revit 2026\RevitAPIUI.dll</HintPath>
			<Private>false</Private>
		</Reference>

	</ItemGroup>


	<!-- ========================================================= -->
	<!-- Resources -->
	<!-- ========================================================= -->

	<ItemGroup>

		<Content Include="Resources\**\*.*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>Resources\%(RecursiveDir)%(Filename)%(Extension)</Link>
		</Content>

	</ItemGroup>


	<!-- ========================================================= -->
	<!-- Folder structure -->
	<!-- ========================================================= -->

	<ItemGroup>

		<Folder Include="Domain\Models\" />

		<Folder Include="FinishEngine\Generation\" />
		<Folder Include="FinishEngine\Debug\" />
		<Folder Include="Parameters\" />
		<Folder Include="Recycle\" />
		<Folder Include="RoomFinish\Utils\" />
		<Folder Include="Tables\Commands\" />
		<Folder Include="Tables\Processing\" />
		<Folder Include="Tables\Storage\" />

	</ItemGroup>


	<!-- ========================================================= -->
	<!-- Revit 2025 build settings -->
	<!-- ========================================================= -->

	<PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
		<RevitVersion>2025</RevitVersion>
		<AddinFolder>C:\ProgramData\Autodesk\Revit\Addins\2025</AddinFolder>
	</PropertyGroup>


	<!-- ========================================================= -->
	<!-- Revit 2026 build settings -->
	<!-- ========================================================= -->

	<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
		<RevitVersion>2026</RevitVersion>
		<AddinFolder>C:\ProgramData\Autodesk\Revit\Addins\2026</AddinFolder>
	</PropertyGroup>


	<!-- ========================================================= -->
	<!-- Copy DLL -->
	<!-- ========================================================= -->

	<Target Name="CopyLongToolDllToRevit" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">

		<MakeDir Directories="$(AddinFolder)" Condition="!Exists('$(AddinFolder)')" />

		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AddinFolder)" />

		<Message Importance="High" Text="==============================================" />

		<Message Importance="High" Text="LongTool - Revit $(RevitVersion)" />

		<Message Importance="High" Text="Target Framework: $(TargetFramework)" />

		<Message Importance="High" Text="DLL copied to: $(AddinFolder)" />

		<Message Importance="High" Text="==============================================" />

	</Target>


	<!-- ========================================================= -->
	<!-- Copy Resources -->
	<!-- ========================================================= -->

	<Target Name="CopyLongToolResourcesToRevit" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">

		<ItemGroup>
			<LongToolResources Include="$(ProjectDir)Resources\**\*.*" />
		</ItemGroup>

		<Copy SourceFiles="@(LongToolResources)" DestinationFiles="@(LongToolResources->'$(AddinFolder)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />

	</Target>


</Project>