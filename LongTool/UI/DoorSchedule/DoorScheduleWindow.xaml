<Window x:Class="LongTool.UI.DoorSchedule.DoorScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LongTool - Door Schedule"
        Width="1400"
        Height="700"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ======================================== -->
        <!-- Header -->
        <!-- ======================================== -->

        <TextBlock Grid.Row="0"
                   Text="Door Schedule"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <!-- ======================================== -->
        <!-- Door Table -->
        <!-- ======================================== -->

        <DataGrid x:Name="DoorDataGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="LightGray"
                  VerticalGridLinesBrush="LightGray">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="HorizontalContentAlignment"
                            Value="Center"/>
                    <Setter Property="VerticalContentAlignment"
                            Value="Center"/>
                    <Setter Property="FontWeight"
                            Value="Bold"/>
                    <Setter Property="Padding"
                            Value="5"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding"
                            Value="5,3"/>
                    <Setter Property="VerticalContentAlignment"
                            Value="Center"/>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>

                <!-- 記号 -->
                <DataGridTextColumn Header="記号"
                                    Binding="{Binding Symbol}"
                                    Width="90"/>

                <!-- W -->
                <DataGridTextColumn Header="W"
                                    Binding="{Binding ShapeWidth, StringFormat={}{0:0}}"
                                    Width="70">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment"
                                    Value="Center"/>
                            <Setter Property="TextAlignment"
                                    Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- H -->
                <DataGridTextColumn Header="H"
                                    Binding="{Binding ShapeHeight, StringFormat={}{0:0}}"
                                    Width="70">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment"
                                    Value="Center"/>
                            <Setter Property="TextAlignment"
                                    Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 扉厚 -->
                <DataGridTextColumn Header="扉厚"
                                    Binding="{Binding DoorThickness}"
                                    Width="70">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment"
                                    Value="Center"/>
                            <Setter Property="TextAlignment"
                                    Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 枠厚 -->
                <DataGridTextColumn Header="枠厚"
                                    Binding="{Binding FrameThickness}"
                                    Width="70">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment"
                                    Value="Center"/>
                            <Setter Property="TextAlignment"
                                    Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 型式 -->
                <DataGridTextColumn Header="型式"
                                    Binding="{Binding Type}"
                                    Width="3*"/>

                <!-- 場所 -->
                <DataGridTextColumn Header="場所"
                                    Binding="{Binding Location}"
                                    Width="1.5*"/>

                <!-- ガラス -->
                <DataGridTextColumn Header="ガラス"
                                    Binding="{Binding Glass}"
                                    Width="2*"/>

                <!-- 仕上 -->
                <DataGridTextColumn Header="仕上"
                                    Binding="{Binding Finish}"
                                    Width="2*"/>

                <!-- 金物 -->
                <DataGridTextColumn Header="金物"
                                    Binding="{Binding Hardware}"
                                    Width="1.5*"/>

                <!-- 備考 -->
                <DataGridTextColumn Header="備考"
                                    Binding="{Binding Remarks}"
                                    Width="1.5*"/>

                <!-- 数量 -->
                <DataGridTextColumn Header="数量"
                                    Binding="{Binding Quantity}"
                                    Width="70">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment"
                                    Value="Center"/>
                            <Setter Property="TextAlignment"
                                    Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

            </DataGrid.Columns>

        </DataGrid>

        <!-- ======================================== -->
        <!-- Footer -->
        <!-- ======================================== -->

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <TextBlock Text="合計："
                       FontSize="16"
                       VerticalAlignment="Center"/>

            <TextBlock x:Name="TotalTextBlock"
                       Text="0"
                       FontSize="16"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="5,0,0,0"/>

        </StackPanel>

    </Grid>

</Window>