<UserControl x:Class="LongTool.Properties.Views.PropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LongTool.Properties.ViewModels" Width="370">


    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="#EAEAEA">
            <TextBlock Text="Properties"
                       FontSize="14"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="10,0"/>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <!-- Sử dụng Grid thay vì StackPanel để có thể co dãn linh hoạt -->
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Identity -->
                    <RowDefinition Height="Auto"/>
                    <!-- Dimensions -->
                    <RowDefinition Height="*"/>
                    <!-- Parameters - chiếm không gian còn lại -->
                </Grid.RowDefinitions>

                <!-- Identity -->
                <Expander Header="Identity Data"
                          IsExpanded="True"
                          Margin="0,2">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Category" Margin="0,2"/>
                        <TextBlock Grid.Column="1" 
                                   Text="{Binding Category}" 
                                   Margin="0,2"/>

                        <TextBlock Grid.Row="1" 
                                   Text="Family" 
                                   Margin="0,2"/>
                        <TextBlock Grid.Column="1" 
                                   Grid.Row="1" 
                                   Text="{Binding Family}" 
                                   Margin="0,2"/>

                        <TextBlock Grid.Row="2" 
                                   Text="Type" 
                                   Margin="0,2"/>
                        <TextBlock Grid.Column="1" 
                                   Grid.Row="2" 
                                   Text="{Binding Type}" 
                                   Margin="0,2"/>

                        <TextBlock Grid.Row="3" 
                                   Text="Level" 
                                   Margin="0,2"/>
                        <TextBlock Grid.Column="1" 
                                   Grid.Row="3" 
                                   Text="{Binding Level}" 
                                   Margin="0,2"/>
                    </Grid>
                </Expander>

                <!-- Dimensions -->
                <Expander Header="Dimensions"
                          IsExpanded="True"
                          Margin="0,2"
                          Grid.Row="1">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Width" Margin="0,2"/>
                        <TextBlock Grid.Column="1" 
                                   Text="{Binding Width, FallbackValue='-'}" 
                                   Margin="0,2"/>

                        <TextBlock Grid.Row="1" 
                                   Text="Height" 
                                   Margin="0,2"/>
                        <TextBlock Grid.Column="1" 
                                   Grid.Row="1" 
                                   Text="{Binding Height, FallbackValue='-'}" 
                                   Margin="0,2"/>

                        <TextBlock Grid.Row="2" 
                                   Text="Thickness" 
                                   Margin="0,2"/>
                        <TextBlock Grid.Column="1" 
                                   Grid.Row="2" 
                                   Text="{Binding Thickness, FallbackValue='-'}" 
                                   Margin="0,2"/>
                    </Grid>
                </Expander>

                <!-- Parameters -->
                <Expander Header="Parameters"
                          IsExpanded="True"
                          Margin="0,2"
                          Grid.Row="2">
                    <DataGrid Margin="0,5"
                              ItemsSource="{Binding Parameters}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="False"
                              HeadersVisibility="Column"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              MinHeight="100">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" 
                                                Binding="{Binding Name}"
                                                Width="*"
                                                MinWidth="80"/>
                            <DataGridTextColumn Header="Value" 
                                                Binding="{Binding Value}"
                                                Width="*"
                                                MinWidth="80"/>
                            <DataGridTextColumn Header="Unit" 
                                                Binding="{Binding Unit}"
                                                Width="80"
                                                MinWidth="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Expander>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>